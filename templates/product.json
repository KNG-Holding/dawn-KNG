{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Udostępnij"
          }
        },
        "shipping_info": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "icon_1": "truck",
            "heading_1": "Wysyłka w 2–4 dni robocze",
            "icon_2": "none",
            "heading_2": "",
            "icon_3": "none",
            "heading_3": ""
          }
        },
        "delivery": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Dostawa",
            "icon": "truck",
            "content": "<p>Zamówienia wysyłamy w ciągu <strong>2–4 dni roboczych</strong>. Dostarczamy przez InPost (Paczkomaty i kurier). Koszt dostawy zobaczysz przy składaniu zamówienia.</p><p><a href=\"/policies/shipping-policy\" title=\"Dostawa\">Szczegóły dostawy</a></p>"
          }
        },
        "returns": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Zwroty",
            "icon": "return",
            "content": "<p>Masz <strong>14 dni</strong> na odstąpienie od umowy bez podawania przyczyny, licząc od dnia otrzymania przesyłki.</p><p><a href=\"/policies/refund-policy\" title=\"Zwroty\">Zasady zwrotów</a></p>"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "shipping_info",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "delivery",
        "returns",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Może Ci się spodobać",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
